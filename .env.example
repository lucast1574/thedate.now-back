PORT=8080
MONGODB_URI=mongodb://thedate:change-me@localhost:27017/?authSource=admin
MONGODB_DATABASE=thedate
JWT_SECRET=replace-with-a-long-random-secret
PUBLIC_EVENTS_URL=https://thedate.now
PUBLIC_WEDDINGS_URL=https://save.thedate.now
STRIPE_SECRET_KEY=sk_test_replace-me
STRIPE_WEBHOOK_SECRET=whsec_replace-me
GOOGLE_CLIENT_ID=replace-with-oauth-client-id
ADMIN_EMAIL=replace-with-verified-admin-email
WAZEND_BASE_URL=https://your-wazend-server
WAZEND_API_KEY=replace-me
WAZEND_SESSION=replace-me
WAZEND_WEBHOOK_HMAC=replace-me
S3_ENDPOINT=thedate-minio:9000
S3_ACCESS_KEY_ID=replace-me
S3_SECRET_ACCESS_KEY=replace-me
S3_USE_SSL=false
S3_WEDDING_BUCKET=thedate-weddings
S3_EVENT_BUCKET=thedate-events

# Stable Google subject for an admin with a non-Gmail/non-Workspace email, if needed.
GOOGLE_ADMIN_SUB=
# Only the dedicated The Date organization key is used for new invitation deployments.
DOKPLOY_URL=https://cloud.rangel.pro
DOKPLOY_THE_DATE_API_KEY=replace-me
# Publish the frontend Dockerfile image to a registry and supply its immutable digest.
DOKPLOY_INVITATION_IMAGE=ghcr.io/your-org/thedate-invitation@sha256:replace-with-64-hex-digest
INVITATION_API_URL=https://api.thedate.now

# Optional dedicated WhatsApp accounts per product; defaults above remain compatible.
# Each session needs its own authenticated WhatsApp number and profile name.
WAZEND_WEDDING_SESSION=
WAZEND_GENERAL_SESSION=
WAZEND_WEDDING_BASE_URL=
WAZEND_GENERAL_BASE_URL=
WAZEND_WEDDING_API_KEY=
WAZEND_GENERAL_API_KEY=
WAZEND_WEDDING_WEBHOOK_HMAC=
WAZEND_GENERAL_WEBHOOK_HMAC=

# Optional automatic renderer releases; each invitation remains pinned to a resolved digest.
DOKPLOY_RENDERER_IMAGE_REPOSITORY=
DOKPLOY_RENDERER_MANIFEST_URL=
